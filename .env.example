# ==============================================================================
# Spark_vLLM 環境變數範本
#
# 使用方式：複製為 .env 後，把下列每個變數改成實際的值（.env 已列入 .gitignore，不會被提交）
#   cp .env.example .env
#
# 這些變數由 docker/docker-compose.yml 讀取，用 ./run.sh 啟動時會自動載入 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Hugging Face
# ------------------------------------------------------------------------------

# Hugging Face Access Token，vLLM 服務（nemotron-lightning、gpt-oss）下載模型時使用
# 取得方式：https://huggingface.co/settings/tokens （Read 權限即可）
HF_TOKEN="Hugging Face API Token"

# （選填）主機上的 Hugging Face 模型快取目錄，會掛載進兩個 vLLM 容器，下載過的模型不會重複下載
# 未設定時自動使用執行者家目錄下的 $HOME/.cache/huggingface/hub，一般情況不需要設定
# 只有模型放在其他位置（例如外接硬碟）時，才取消註解並改成絕對路徑（指到 huggingface/hub 這一層）
# HF_CACHE_DIR="/path/to/huggingface/hub"

# ------------------------------------------------------------------------------
# LiteLLM（統一 API 入口，對外埠 4000）
# ------------------------------------------------------------------------------

# LiteLLM 管理員金鑰（Master Key）：呼叫 LiteLLM API、建立其他 API Key 時使用
# 必須以 "sk-" 開頭，建議使用隨機字串，例如：echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY="sk-your-master-key"

# LiteLLM 使用的 PostgreSQL（litellm-db）密碼，用來儲存 API Key 與使用紀錄
# 注意 1：密碼會被組進 DATABASE_URL，請避免使用空白及 @ : / ? # % $ 等特殊字元
# 注意 2：只有在資料庫「第一次建立」時才會套用，之後再修改需另外處理（見 README 的注意事項）
LITELLM_DB_PASSWORD="LITELLM DB PASSWORD"

# LiteLLM 管理介面（http://<主機 IP>:4000/ui）的登入帳號與密碼
LITELLM_UI_USERNAME="LITELLM UI USERNAME"
LITELLM_UI_PASSWORD="LITELLM UI PASSWORD"